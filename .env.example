# Email MCP Server Configuration

# The server automatically reads .env from its current working directory.
# MCP clients can set EMAIL_ENV_FILE to this file's absolute path.
# EMAIL_ENV_FILE is set in the MCP client configuration, not inside this file.

# ===== OPTION 1: Multiple Accounts (JSON) =====
# Configure any number of named email accounts in JSON format
EMAIL_ACCOUNTS_JSON='{
  "work": {
    "smtp": {
      "host": "smtp.mail.me.com",
      "port": 587,
      "secure": false,
      "user": "your-email@icloud.com",
      "password": "your-app-specific-password"
    },
    "imap": {
      "host": "imap.mail.me.com",
      "port": 993,
      "secure": true,
      "user": "your-email@icloud.com",
      "password": "your-app-specific-password"
    },
    "default_from_name": "Your Name",
    "sender_emails": ["your-email@icloud.com"]
  },
  "personal": {
    "smtp": {
      "host": "smtp.gmail.com",
      "port": 587,
      "user": "your-email@gmail.com",
      "password": "your-app-specific-password"
    },
    "imap": {
      "host": "imap.gmail.com",
      "port": 993,
      "user": "your-email@gmail.com",
      "password": "your-app-specific-password"
    },
    "default_from_name": "Your Name"
  }
}'

# Default account to use if not specified in tool calls
DEFAULT_EMAIL_ACCOUNT="work"

# ===== OPTION 2: Single Account (Individual Variables) =====
# Use these if you only have one email account
# SMTP_HOST="smtp.mail.me.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="your-email@icloud.com"
# SMTP_PASS="your-app-specific-password"
# SMTP_USERNAME="your-email@icloud.com"        # Alias for SMTP_USER
# SMTP_PASSWORD="your-app-specific-password"   # Alias for SMTP_PASS
# IMAP_HOST="imap.mail.me.com"
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER="your-email@icloud.com"
# IMAP_PASS="your-app-specific-password"
# IMAP_USERNAME="your-email@icloud.com"        # Alias for IMAP_USER
# IMAP_PASSWORD="your-app-specific-password"   # Alias for IMAP_PASS
# DEFAULT_FROM_NAME="Your Name"
# SENDER_EMAILS="your-email@icloud.com,alias@example.com"

# ===== NOTES =====
# For Gmail: Use App-Specific Passwords (not your regular password)
# For iCloud: Use App-Specific Passwords
# For other providers: Check their SMTP/IMAP settings documentation
