# Credentials for `npm run test:live` (copy to .env.live, which is git-ignored).
# The test only touches messages whose subject carries a unique run id plus its own folders.
LIVE_SMTP_HOST=smtp.ionos.de
LIVE_SMTP_PORT=587
LIVE_IMAP_HOST=imap.ionos.de
LIVE_IMAP_PORT=993

# Mailbox under test. Mail is sent to this mailbox itself.
LIVE_A_USER=info@example.com
LIVE_A_PASS=

# An address you control outside this mailbox; the forward test is sent there.
LIVE_EXTERNAL_TO=you@example.org

# Optional second mailbox: delivery is then checked between A and B instead.
# LIVE_B_USER=
# LIVE_B_PASS=

# Pause before every tool call in ms (default 250) to stay below provider rate limits
# LIVE_DELAY_MS=250
