{
  "name": "email-smtp-imap-mcp",
  "version": "2.1.2",
  "description": "Multi-account email MCP server for SMTP sending, IMAP search, replies, attachments, and inbox organization",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "type": "module",
  "bin": {
    "email-smtp-imap-mcp": "build/index.js"
  },
  "files": [
    "build/",
    "docs/assets/",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node build/index.js",
    "watch": "tsc --watch",
    "prepare": "npm run build",
    "dev": "npm run build && npm start"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "imapflow": "^1.6.6",
    "mailparser": "^3.9.15",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "mcp",
    "email",
    "smtp",
    "imap",
    "ai",
    "mcp-server",
    "email-automation",
    "multi-account",
    "model-context-protocol",
    "claude",
    "nodemailer",
    "imapflow"
  ],
  "author": "Sami Halawa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samihalawa/email-smtp-imap-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/samihalawa/email-smtp-imap-mcp/issues"
  },
  "homepage": "https://github.com/samihalawa/email-smtp-imap-mcp#readme",
  "engines": {
    "node": ">=20.0.0"
  }
}
